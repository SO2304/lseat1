---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const title = 'Contact Ingénierie | LSEAT Aerospace - Dossier Part 21J et EASA Form 1';
const description =
  "Contactez les ingénieurs LSEAT Aerospace : dossier technique EASA Form 1, documentation Part 21J, notes de certification dynamique 16G, procédure d'installation MRO et devis flotte. Réponse technique sous 48 h ouvrées.";

const deliverables = [
  {
    ref: 'DOC-01',
    label: 'EASA Form 1',
    detail: 'Certificat de libération de pièce, délivré par lot ou par numéro de série.',
  },
  {
    ref: 'DOC-02',
    label: 'Dossier Part 21J',
    detail: 'Dossier de conception et de certification complet, prêt pour soumission au DOA.',
  },
  {
    ref: 'DOC-03',
    label: 'Notes de certification dynamique 16G',
    detail: "Justificatifs d'essai dynamique, commandes de sécurité et critères d'acceptation.",
  },
  {
    ref: 'DOC-04',
    label: "Procédure d'installation MRO",
    detail: "Séquence de retrofit, outillage, temps de main-d'œuvre et contrôle post-installation.",
  },
  {
    ref: 'DOC-05',
    label: 'Devis flotte',
    detail: 'Coût de retrofit par siège, par appareil, par type et par plan de déploiement.',
  },
];
---

<BaseLayout title={title} description={description}>
  <section id="contact" class="relative bg-deep-navy py-24 md:py-30">
    <div class="section-container">
      <div class="section-header">
        <span class="section-badge">Contact Ingénierie</span>
        <h1 class="section-title text-balance">Contacter un ingénieur LSEAT Aerospace</h1>
        <p class="section-subtitle text-balance">
          Demande adressée directement au bureau d'études cabinage et certification. Aucun
          intermédiaire, aucun revendeur. Réponse technique sous 48 h ouvrées.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-10 lg:grid-cols-5 lg:gap-12">
        <div class="lg:col-span-3">
          <div class="glassmorphism-lg">
            <ContactForm />
          </div>
        </div>

        <div class="lg:col-span-2">
          <div class="glassmorphism-card h-full">
            <h2 class="text-display-sm text-pure-white font-display">
              Ce que vous recevez en réponse
            </h2>
            <p class="mt-3 text-body-sm text-pure-white/70">
              Chaque requête qualifiée ouvre l'envoi du paquet documentaire complet, en anglais
              technique, sous forme de PDF signés.
            </p>

            <ul class="mt-8 space-y-5">
              {
                deliverables.map((item) => (
                  <li class="flex gap-4">
                    <span class="mt-1 shrink-0 font-mono text-caption text-electric-cyan">
                      {item.ref}
                    </span>
                    <span>
                      <span class="block text-body-base font-semibold text-pure-white">
                        {item.label}
                      </span>
                      <span class="mt-1 block text-body-sm text-pure-white/70">
                        {item.detail}
                      </span>
                    </span>
                  </li>
                ))
              }
            </ul>

            <div class="mt-8 border-t border-pure-white/10 pt-8">
              <p class="text-caption text-pure-white/50">Canal direct</p>
              <a
                href="mailto:contact@lseat.eu"
                class="mt-3 inline-flex items-center gap-3 text-body-lg font-semibold text-electric-cyan transition-colors duration-200 hover:text-pure-white"
              >
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
                contact@lseat.eu
              </a>
              <p class="mt-3 text-body-sm text-pure-white/70">
                Format à renseigner&nbsp;: type d'appareil, nombre de sièges, base de maintenance
                et localisation du parc. Ces quatre données suffisent à un chiffrage sans échange
                supplémentaire.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>