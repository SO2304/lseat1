---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/og-image.svg' } = Astro.props;

const base = Astro.site ?? new URL('https://lseat.eu/');
const siteUrl = new URL('/', base).toString();
const canonicalUrl = new URL(Astro.url.pathname, base).toString();
const ogImageUrl = new URL(ogImage, base).toString();

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}#organization`,
  name: 'LSEAT Aerospace',
  url: siteUrl,
  email: 'contact@lseat.eu',
  description:
    "Fabricant de kits de conversion ergonomique passager à mode sommeil pour cabines d'aéronefs commerciaux. Dossiers de certification EASA Part 21J et FAA Part 21.",
  knowsAbout: [
    'EASA Part 21J',
    'FAA Part 21',
    'CS-25',
    'FAR-25',
    'EASA Form 1',
    'Cabine passager',
    'Retrofit MRO',
  ],
};

const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: 'LSEAT Aerospace',
  inLanguage: 'fr-FR',
  publisher: { '@id': `${siteUrl}#organization` },
};

const product = {
  '@type': 'Product',
  '@id': `${siteUrl}#product`,
  name: 'LSEAT 16G Economy Conversion Kit',
  description:
    'Kit de conversion ergonomique passager à mode sommeil 40°, moins de 1 650 g pour 3 sièges, 0 W, retrofit MRO en moins de 15 min par siège. Certification EASA CS-25 / FAR-25, dossier Part 21J et EASA Form 1.',
  category: 'Aéronautique - aménagement intérieur cabine / retrofit aéronautique',
  brand: { '@type': 'Brand', name: 'LSEAT Aerospace' },
  manufacturer: { '@id': `${siteUrl}#organization` },
};

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [organization, website, product],
});
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="LSEAT Aerospace" />
    <meta
      name="keywords"
      content="kit conversion économie 16G, siège passager mode sommeil, aéronautique, aménagement intérieur cabine, EASA Part 21J, FAA Part 21, CS-25, FAR-25, EASA Form 1, retrofit MRO, LSEAT Aerospace"
    />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0B192C" />
    <meta name="color-scheme" content="dark" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LSEAT Aerospace" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content="LSEAT Aerospace - kit de conversion Économie 16G" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="LSEAT Aerospace - kit de conversion Économie 16G" />

    <script type="application/ld+json" set:html={structuredData} />
  </head>

  <body class="min-h-screen bg-deep-navy font-sans text-pure-white antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-electric-cyan focus:px-4 focus:py-2 focus:text-body-sm focus:font-semibold focus:text-deep-navy"
    >
      Aller au contenu principal
    </a>

    <Header />

    <main id="main" class="relative">
      <slot />
    </main>

    <Footer />
  </body>
</html>